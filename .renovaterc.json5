{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/renovate-config"],
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    {
      matchManagers: ["npm"],
      matchPackageNames: ["wrangler"],
      postUpgradeTasks: {
        workingDirTemplate: "apps/web",
        commands: ["pnpm install --frozen-lockfile --ignore-scripts", "pnpm run cf-typegen"],
        fileFilters: ["apps/web/worker-configuration.d.ts"],
        installTools: { node: {}, pnpm: {} },
      },
    },
    {
      description: "The Vite plugin requires the wrangler from its own release",
      matchSourceUrls: ["https://github.com/cloudflare/workers-sdk"],
      groupName: "workers-sdk monorepo",
    },
  ],
}
