{
  "name": "@hydesign/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run cf-typegen && vp dev --host 0.0.0.0 --config vite.app.config.ts",
    "build": "pnpm run cf-typegen && vp build --config vite.app.config.ts",
    "preview": "vp preview --config vite.app.config.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "lint": "pnpm run cf-typegen && vp lint",
    "format": "vp fmt"
  },
  "dependencies": {
    "@hydesign/ui": "workspace:*",
    "@marsidev/react-turnstile": "^1.6.2",
    "@shopify/storefront-api-client": "^2.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "canvas-confetti": "^1.9.4",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "1.58.0",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "4.151.0"
  }
}
