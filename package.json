{
  "name": "hydesign-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run cf-typegen && vite dev --host 0.0.0.0",
    "build": "pnpm run cf-typegen && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "format": "oxfmt .",
    "fmt-check": "oxfmt --check .",
    "lint": "pnpm run cf-typegen && oxlint .",
    "lint:fix": "pnpm run cf-typegen && oxlint --fix .",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "photo": "node scripts/photo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@shopify/storefront-api-client": "^2.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "canvas-confetti": "^1.9.4",
    "cn": "0.5.2",
    "cva": "1.0.0-beta.12",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "1.70.0",
    "motion": "^14.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.36.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "exiftool-vendored": "^39.1.1",
    "image-size": "^2.0.4",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
